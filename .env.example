# Public app URL used for canonical metadata and OAuth redirect base
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase project URL and public anonymous API key
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Optional service role key for trusted server jobs (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Optional Vercel deployment metadata
VERCEL_PROJECT_ID=""
VERCEL_ORG_ID=""
